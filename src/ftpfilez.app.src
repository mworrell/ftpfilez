{application, ftpfilez,
 [
  {description, "Simple FTPS service for storing files"},
  {vsn, "git"},
  {registered, []},
  {mod, {ftpfilez_app, []}},
  {applications, [
                  kernel,
                  stdlib,
                  crypto,
                  public_key,
                  ssl,
                  inets,
                  ftp,
                  gproc,
                  jobs,
                  zotonic_stdlib,
                  tls_certificate_check
                 ]},
  {env, [
      {max_connections, 4},
      {connection_idle_timeout_ms, 300000},
      {connection_close_timeout_ms, 5000}
  ]},
  {licenses, ["Apache-2.0"]},
  {links, [{"GitHub", "https://github.com/mworrell/ftpfilez"}]}
 ]}.
